local function UpdateStatus(text, color)
	if state.statusText then
		state.statusText.Text = text
		if color then
			state.statusText.TextColor3 = color
		end
	end
end

local function CheckLowHealthAndSafety(rootPart, humanoid)
	if not rootPart or not humanoid then return false end

	if rootPart.Position.Y < -50 then
		rootPart.CFrame = CONFIG.DropCFrame
		UpdateStatus("สถานะ: ป้องกันการตกแมพ!", Color3.fromRGB(241, 196, 15))
		task.wait(1)
		return true
	end

	if state.isEscapeEnabled and humanoid.Health > 0 and humanoid.Health <= CONFIG.LowHealthThreshold then
		local currentTime = tick()
		if (currentTime - state.lastEscapeTick) >= CONFIG.EscapeCooldown then
			rootPart.CFrame = CONFIG.DropCFrame
			state.lastEscapeTick = currentTime 
			UpdateStatus("สถานะ: เลือดน้อย! วาร์ปหนีแล้ว", Color3.fromRGB(231, 76, 60))
			task.wait(1)
			return true
		end
	end

	return false
end

local function RunAutoFarm(rootPart)
	local inventory = player:FindFirstChild("Inventory")
	local oldAxe = inventory and inventory:FindFirstChild("Old Axe")
	if not oldAxe then return end

	local remoteEvents = ReplicatedStorage:FindFirstChild("RemoteEvents")
	local toolDamageRemote = remoteEvents and remoteEvents:FindFirstChild("ToolDamageObject")
	local stopDraggingRemote = remoteEvents and remoteEvents:FindFirstChild("StopDraggingItem")

	if state.subFeatures.AutoCutTree then
		local foliage = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Foliage")
		if foliage then
			for _, child in ipairs(foliage:GetChildren()) do
				if child.Name == "Small Tree" or child.Name == "Birch Tree" then
					local treePart = child:IsA("Model") and (child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")) or (child:IsA("BasePart") and child)
					if treePart and (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(treePart.Position.X, 0, treePart.Position.Z)).Magnitude <= CONFIG.FarmDistance then
						if toolDamageRemote then
							task.spawn(function()
								pcall(function()
									toolDamageRemote:InvokeServer(child, oldAxe, "91_10404440657", rootPart.CFrame, false)
								end)
							end)
						end
					end
				end
			end
		end
	end

	local itemsFolder = Workspace:FindFirstChild("Items")
	if itemsFolder then
		for _, item in ipairs(itemsFolder:GetChildren()) do
			local itemName = item.Name:lower()
			local primaryPart = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart"))
			if primaryPart then
				pcall(function()
					local shouldTeleport = false
					local targetCFrame = CONFIG.DropCFrame

					if itemName == "log" and state.subFeatures.TeleportLog then
						shouldTeleport = true
						targetCFrame = (math.random(1, 100) <= state.fireDropPercentage) and CONFIG.FireCFrame or CONFIG.DropCFrame
					elseif (itemName == "carrot" or itemName == "berry") and state.subFeatures.TeleportFood then
						shouldTeleport = true
						targetCFrame = CONFIG.CarrotBerryCFrame
					elseif (itemName == "broken fan" or itemName == "old radio") and state.subFeatures.TeleportFire then
						shouldTeleport = true
						targetCFrame = CONFIG.FireCFrame
					elseif (itemName == "coal" or itemName == "morsel" or itemName == "steak" or itemName == "raw meat" or itemName:find("meat")) and state.subFeatures.TeleportMeat then
						shouldTeleport = true
						targetCFrame = CONFIG.DropCFrame
					end

					if shouldTeleport then
						item:PivotTo(targetCFrame)
						for _, part in ipairs(item:GetDescendants()) do
							if part:IsA("BasePart") then
								part.Anchored = false
								part.AssemblyLinearVelocity = Vector3.new(0, -25, 0)
							end
						end
					end
				end)
			end

			if stopDraggingRemote then
				pcall(function()
					stopDraggingRemote:FireServer(item)
				end)
			end
		end
	end
end

local function RunKillMonster(rootPart)
	local inventory = player:FindFirstChild("Inventory")
	local oldAxe = inventory and inventory:FindFirstChild("Old Axe")
	if not oldAxe then return end

	local remoteEvents = ReplicatedStorage:FindFirstChild("RemoteEvents")
	local toolDamageRemote = remoteEvents and remoteEvents:FindFirstChild("ToolDamageObject")

	local charactersFolder = Workspace:FindFirstChild("Characters")
	if charactersFolder then
		for _, charModel in ipairs(charactersFolder:GetChildren()) do
			if charModel.Name == "Bunny" or charModel.Name == "Bee" or charModel.Name == "Wolf" or charModel.Name == "Cultist" then
				local targetPart = charModel:IsA("Model") and (charModel.PrimaryPart or charModel:FindFirstChildWhichIsA("BasePart")) or (charModel:IsA("BasePart") and child)
				if targetPart and (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(targetPart.Position.X, 0, targetPart.Position.Z)).Magnitude <= CONFIG.FarmDistance then
					if toolDamageRemote then
						task.spawn(function()
							pcall(function()
								local stringID = (charModel.Name == "Cultist") and "4_10404440657" or "91_10404440657"
								toolDamageRemote:InvokeServer(charModel, oldAxe, stringID, rootPart.CFrame, false)
							end)
						end)
					end
				end
			end
		end
	end

	-- โค้ดสำหรับ Crossbow Cultist ตามที่ระบุ
	local crossbowCultist = charactersFolder and charactersFolder:FindFirstChild("Crossbow Cultist")
	if crossbowCultist and oldAxe and toolDamageRemote then
		local targetPart = crossbowCultist:IsA("Model") and (crossbowCultist.PrimaryPart or crossbowCultist:FindFirstChildWhichIsA("BasePart"))
		if targetPart and (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(targetPart.Position.X, 0, targetPart.Position.Z)).Magnitude <= CONFIG.FarmDistance then
			task.spawn(function()
				pcall(function()
					local args = {
						crossbowCultist,
						oldAxe,
						"10_10404440657",
						rootPart.CFrame,
						false
					}
					toolDamageRemote:InvokeServer(unpack(args))
				end)
			end)
		end
	end
end

ApplyNoDarkness(true)

task.spawn(function()
	while state.isRunning do
		pcall(function()
			if state.isNoDarkEnabled then
				Lighting.Brightness = 2
				Lighting.ClockTime = 14
				Lighting.GlobalShadows = false
			end

			local char = player.Character or player.CharacterAdded:Wait()
			local rootPart = char:FindFirstChild("HumanoidRootPart")
			local humanoid = char:FindFirstChild("Humanoid")

			if not rootPart or not humanoid then return end

			rangeAdornment.CFrame = rootPart.CFrame * CFrame.new(0, -rootPart.Size.Y/2, 0) * CFrame.Angles(math.rad(90), 0, 0)

			if CheckLowHealthAndSafety(rootPart, humanoid) then
			return
			end

			local isWorking = false

			if state.isAutoFarmMaster and humanoid.Health > 0 then
				RunAutoFarm(rootPart)
				isWorking = true
			end

			if state.isKillEnabled and humanoid.Health > 0 then
				RunKillMonster(rootPart)
				isWorking = true
			end

			if isWorking then
				UpdateStatus("สถานะ: กำลังทำงานอัตโนมัติ...", Color3.fromRGB(46, 204, 113))
			else
				UpdateStatus("สถานะ: พักการทำงาน (หยุดชั่วคราว)", Color3.fromRGB(189, 195, 199))
			end
		end)
		
		task.wait(CONFIG.LoopCooldown)
	end
end)

SetupUI()
