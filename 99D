	local function makeDraggable(obj, header)
		local activeDragInput = nil; local startPos; local dragStart
		header.InputBegan:Connect(function(i)
			if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
				activeDragInput = i; dragStart = i.Position; startPos = obj.Position
			end
