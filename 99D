local function ApplyNoDarkness(enabled)
	pcall(function()
		if enabled then
			Lighting.Brightness = 2
			Lighting.ClockTime = 14
			Lighting.FogEnd = 100000
			Lighting.GlobalShadows = false
			Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
			Lighting.Ambient = Color3.fromRGB(255, 255, 255)
		else
			Lighting.Brightness = originalLighting.Brightness
			Lighting.ClockTime = originalLighting.ClockTime
			Lighting.FogEnd = originalLighting.FogEnd
			Lighting.GlobalShadows = originalLighting.GlobalShadows
			Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
			Lighting.Ambient = originalLighting.Ambient
		end
	end)
end

local function TriggerTeleport(filterType)
	local itemsFolder = Workspace:FindFirstChild("Items")
	local stopDraggingRemote = ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("StopDraggingItem")
	local count = 0

	if itemsFolder then
		local targetItems = {}
		
		for _, item in ipairs(itemsFolder:GetChildren()) do
			local itemName = item.Name:lower()
			local primaryPart = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")) or (item:IsA("BasePart") and item)
			if primaryPart then
				local shouldTeleport = false
				local targetCFrame = CONFIG.DropCFrame

				if filterType == "Log" then
					if itemName == "log" or itemName == "fuel canister" then
						shouldTeleport = true
						targetCFrame = CONFIG.TreeCFrame
					end
				elseif filterType == "CarrotBerry" then
					if itemName == "carrot" or itemName == "berry" then
						shouldTeleport = true
						targetCFrame = CONFIG.CarrotBerryCFrame
					end
				elseif filterType == "FanRadio" then
					if itemName == "broken fan" or itemName == "old radio" or itemName == "sheet metal" or itemName == "tyre" or itemName == "broken microwave" then
						shouldTeleport = true
						targetCFrame = CONFIG.FanRadioCFrame
					end
				elseif filterType == "Bandage" then
					if itemName == "bandage" then
						shouldTeleport = true
						targetCFrame = CONFIG.BandageCFrame
					end
				elseif filterType == "Coal" then
					if itemName == "coal" then
						shouldTeleport = true
						targetCFrame = CONFIG.TreeCFrame
					end
				elseif filterType == "Meat" then
					if itemName == "morsel" or itemName == "steak" or itemName == "raw meat" or itemName:find("meat") then
						shouldTeleport = true
						targetCFrame = CONFIG.DropCFrame
					end
				end

				if shouldTeleport then
					table.insert(targetItems, {item = item, targetCFrame = targetCFrame})
				end
			end
		end

		local limitCount = math.min(3, #targetItems)
		
		task.spawn(function()
			for i = 1, limitCount do
				local data = targetItems[i]
				pcall(function()
					local item = data.item
					local targetCFrame = data.targetCFrame

					for _, part in ipairs(item:GetDescendants()) do
						if part:IsA("BasePart") then
							part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
							part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
							part.Velocity = Vector3.new(0, 0, 0)
							part.Anchored = false
						end
					end

					if item:IsA("Model") then
						item:PivotTo(targetCFrame)
					elseif item:IsA("BasePart") then
						item.CFrame = targetCFrame
					end

					if stopDraggingRemote then
						stopDraggingRemote:FireServer(item)
					end

					task.defer(function()
						task.wait(0.05)
						for _, part in ipairs(item:GetDescendants()) do
							if part:IsA("BasePart") then
								part.AssemblyLinearVelocity = Vector3.new(0, -5, 0)
								part.Velocity = Vector3.new(0, -5, 0)
								part.Anchored = false
							end
						end
					end)
				end)
				RunService.Heartbeat:Wait()
			end
		end)
		
		count = limitCount
	end
	return count
end

local function tween(obj, props, time)
	TweenService:Create(obj, TweenInfo.new(time or 0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), props):Play()
end

